# Application Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=super_secret_intervue_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Settings (Local / MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/intervue-ai

# AI Model API Providers
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
